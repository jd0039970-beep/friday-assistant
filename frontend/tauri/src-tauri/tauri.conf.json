{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "F.R.I.D.A.Y",
  "version": "0.4.0",
  "identifier": "com.friday.assistant",
  "build": {
    "frontendDist": "../hud-embed",
    "devUrl": "http://127.0.0.1:8787/hud/"
  },
  "app": {
    "windows": [
      {
        "title": "F.R.I.D.A.Y",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "friday-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
