FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    hashcat \
    john \
    binwalk \
    file \
    strings \
    testdisk \
    foremost \
    sleuthkit \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /sandbox/fixtures
COPY fixtures/ /sandbox/fixtures/

WORKDIR /work
USER nobody
